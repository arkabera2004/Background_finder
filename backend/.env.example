ENVIRONMENT=development

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

REDIS_URL=redis://localhost:6379/0

# AI provider: gemini | ollama | anthropic. gemini/ollama are free and are
# the only providers the Free Basic Plan ever calls; anthropic is optional
# and only used if explicitly selected here.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
ANTHROPIC_API_KEY=
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
CLAUDE_MODEL_SMART=claude-sonnet-5

# Search provider: duckduckgo (free, keyless, default) | searxng | tavily | exa | brave
SEARCH_PROVIDER=duckduckgo
SEARXNG_BASE_URL=
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=

# Website extraction: local (trafilatura, free, default) | firecrawl
EXTRACTION_PROVIDER=local
FIRECRAWL_API_KEY=
JINA_READER_API_KEY=

MAX_RUNS_PER_USER_PER_DAY=30
MAX_CONCURRENT_RUNS_PER_USER=3
DEFAULT_RETENTION_DAYS=90

# Local SQLite by default; set to postgresql://... once Supabase Postgres
# is provisioned (same application code, no changes needed).
DATABASE_URL=sqlite:///./prospectlens.db

CORS_ORIGINS=["http://localhost:3000"]
