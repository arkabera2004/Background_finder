{
  "$defs": {
    "Claim": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "source_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence",
          "default": "medium"
        },
        "is_inference": {
          "default": false,
          "title": "Is Inference",
          "type": "boolean"
        }
      },
      "required": [
        "text"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Hook": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence",
          "default": "medium"
        }
      },
      "required": [
        "text",
        "source_ids"
      ],
      "title": "Hook",
      "type": "object"
    },
    "Source": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        }
      },
      "required": [
        "id",
        "url"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "properties": {
    "prospect_name": {
      "title": "Prospect Name",
      "type": "string"
    },
    "snapshot": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Snapshot",
      "type": "array"
    },
    "career_story": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Career Story",
      "type": "array"
    },
    "current_role": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Current Role",
      "type": "array"
    },
    "company": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Company",
      "type": "array"
    },
    "content_and_interests": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Content And Interests",
      "type": "array"
    },
    "communication_style": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Communication Style",
      "type": "array"
    },
    "hooks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Hook"
      },
      "title": "Hooks",
      "type": "array"
    },
    "likely_priorities": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Likely Priorities",
      "type": "array"
    },
    "dos_and_donts": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Dos And Donts",
      "type": "array"
    },
    "sources": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Source"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "prospect_name"
  ],
  "title": "ProspectBrief",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arkabera2004/Background_finder/docs/brief-schema.json"
}
